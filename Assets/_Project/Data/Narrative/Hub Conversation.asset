  m_Script: {fileID: 11500000, guid: f9cc292f44716b947955d71b6c3bb880, type: 3}
  m_Name: Hub Conversation
  m_EditorClassIdentifier: Assembly-CSharp::ProjectBelow.Narrative.DialogueDefinition
  _entryNodeId: draft
  _nodes:
  - _id: draft
    _speaker: {fileID: 11400000, guid: ca77662d5a3d33843be6176dc86b0adf, type: 2}
    _text: "\u0423 \u043F\u043E\u043B\u043E\u043A \u043E\u043F\u044F\u0442\u044C
      \u0442\u044F\u043D\u0435\u0442 \u0445\u043E\u043B\u043E\u0434\u043E\u043C.
      \u0421\u0430\u0432\u0435\u043B\u0438\u0439, \u043A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0448\u044C,
      \u0441 \u0447\u0435\u0433\u043E \u043D\u0430\u0447\u043D\u0451\u043C?"
    _nextNodeId: priorities
    _choices: []
  - _id: priorities
    _speaker: {fileID: 11400000, guid: 2d43f6cf09b18f744a3b3e7c6bb791e7, type: 2}
    _text: "\u041C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C,
      \u043A\u0430\u043A \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F \u043F\u0440\u0438\u043F\u0430\u0441\u044B,
      \u0438\u043B\u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C,
      \u043E\u0442\u043A\u0443\u0434\u0430 \u0438\u0434\u0451\u0442 \u0441\u043A\u0432\u043E\u0437\u043D\u044F\u043A."
    _nextNodeId: 
    _choices:
    - _text: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0437\u0430\u043F\u0430\u0441\u044B"
      _nextNodeId: pantry
      _flagId: hub.plan_pantry
    - _text: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u044E"
      _nextNodeId: vent
      _flagId: hub.plan_vent
  - _id: pantry
    _speaker: {fileID: 11400000, guid: ca77662d5a3d33843be6176dc86b0adf, type: 2}
    _text: "\u0422\u043E\u0433\u0434\u0430 \u043D\u0430\u0447\u043D\u0451\u043C \u0441
      \u043F\u043E\u043B\u043E\u043A. \u0415\u0441\u043B\u0438 \u0432 \u043D\u0438\u0436\u043D\u0438\u0445
      \u044F\u0449\u0438\u043A\u0430\u0445 \u0441\u044B\u0440\u043E, \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u0438\u043C
      \u0438\u0445 \u043F\u043E\u0432\u044B\u0448\u0435."
    _nextNodeId: pantry_end
    _choices: []
  - _id: pantry_end
    _speaker: {fileID: 11400000, guid: 2d43f6cf09b18f744a3b3e7c6bb791e7, type: 2}
    _text: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C.
      \u042F \u0437\u0430\u043F\u0438\u0448\u0443, \u043A\u0430\u043A\u0438\u0435
      \u044F\u0449\u0438\u043A\u0438 \u043C\u044B \u0443\u0436\u0435 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438."
    _nextNodeId: 
    _choices: []
  - _id: vent
    _speaker: {fileID: 11400000, guid: 2d43f6cf09b18f744a3b3e7c6bb791e7, type: 2}
    _text: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u0443\u044E
      \u0440\u0435\u0448\u0451\u0442\u043A\u0443. \u041F\u043E \u0441\u043A\u0432\u043E\u0437\u043D\u044F\u043A\u0443
      \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u043E\u0449\u0435 \u043D\u0430\u0439\u0442\u0438
      \u0449\u0435\u043B\u044C."
    _nextNodeId: vent_end
    _choices: []
  - _id: vent_end
    _speaker: {fileID: 11400000, guid: ca77662d5a3d33843be6176dc86b0adf, type: 2}
    _text: "\u0412\u043E\u0437\u044C\u043C\u0443 \u0444\u043E\u043D\u0430\u0440\u044C,
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0433\u043B\u044F\u043D\u0443\u0442\u044C
      \u0437\u0430 \u0440\u0435\u0448\u0451\u0442\u043A\u0443."
    _nextNodeId: 
    _choices: []
